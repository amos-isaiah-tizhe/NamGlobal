# Copy to .env.test for running the test suite locally against a real
# test database/Redis instance (never staging/production — Section 2.24).
NODE_ENV=test
SITE_NAME=Nam Global
SITE_URL=https://namsglobal.com
CONTACT_EMAIL=hello@namsglobal.com
SESSION_SECRET=test-only-secret-do-not-use-elsewhere

# Point these at a disposable test database/Redis instance — integration
# tests create and delete data freely.
MONGODB_URI=mongodb://localhost:27017/nam_global_test
REDIS_URL=redis://localhost:6379/1

# Payment providers — TEST/SANDBOX keys only, per Section 2.24 ("never use
# live payment-provider keys anywhere except production").
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_test_placeholder
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_WEBHOOK_SECRET=test_placeholder
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-placeholder
FLUTTERWAVE_WEBHOOK_SECRET=test_placeholder
