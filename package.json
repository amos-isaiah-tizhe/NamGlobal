{
  "name": "nam-global",
  "version": "0.1.0",
  "description": "Nam Global — full-stack e-commerce platform (phones, gadgets, buy/sell/swap)",
  "license": "UNLICENSED",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "worker": "node worker.js",
    "worker:dev": "nodemon worker.js",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:reload": "pm2 reload ecosystem.config.js --env production",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:status": "migrate-mongo status",
    "seed": "node seed/index.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage",
    "loadtest": "node scripts/loadtest.js"
  },
  "dependencies": {
    "@sentry/node": "^10.67.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.80.9",
    "compression": "^1.8.1",
    "connect-mongo": "^6.0.0",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "isomorphic-dompurify": "^3.19.0",
    "mongoose": "^9.7.4",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "redis": "^6.1.0",
    "resend": "^6.17.2",
    "slugify": "^1.6.9",
    "speakeasy": "^2.0.0",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "jest": "^30.4.2",
    "migrate-mongo": "^14.0.7",
    "nodemon": "^3.1.4",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  }
}
