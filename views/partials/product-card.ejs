<article class="product-card">
  <a href="/product/<%= product.slug %>" class="product-card__link">
    <div class="product-card__image-wrap">
      <img src="<%= cloudinaryResize(product.images && product.images[0] ? product.images[0] : '/images/branding/hero.svg', { width: 400 }) %>" alt="<%= product.name %>" class="product-card__image" loading="lazy" width="400" height="400">
      <% if (product.flashSale) { %><span class="badge badge--accent">Flash Sale</span><% } %>
      <% if (product.newArrival) { %><span class="badge badge--neutral">New</span><% } %>
      <% if (product.stock === 0) { %><span class="badge badge--dark">Out of stock</span><% } %>
    </div>
    <h3 class="product-card__name"><%= product.name %></h3>
    <p class="product-card__price">
      <% if (product.discountPrice) { %>
        <span class="product-card__price-discount">&#8358;<%= product.discountPrice.toLocaleString() %></span>
        <span class="product-card__price-original">&#8358;<%= product.price.toLocaleString() %></span>
      <% } else { %>
        <span class="product-card__price-discount">&#8358;<%= product.price.toLocaleString() %></span>
      <% } %>
    </p>
  </a>
</article>
