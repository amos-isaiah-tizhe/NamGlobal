<section class="account-page">
  <h1>My Profile</h1>

  <form data-profile-form class="auth-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>First name<input type="text" name="firstName" value="<%= user.firstName %>" required></label>
    <label>Last name<input type="text" name="lastName" value="<%= user.lastName %>" required></label>
    <label>Phone<input type="tel" name="phone" value="<%= user.phone || '' %>"></label>
    <button type="submit" class="btn btn--primary">Save profile</button>
  </form>

  <h2>Change password</h2>
  <form data-password-form class="auth-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Current password<input type="password" name="currentPassword" required></label>
    <label>New password<input type="password" name="newPassword" required></label>
    <button type="submit" class="btn btn--outline">Change password</button>
  </form>
</section>
