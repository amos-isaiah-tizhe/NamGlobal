<h1>Site Settings</h1>

<form method="POST" action="/admin/settings" class="admin-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <fieldset>
    <legend>Payment providers (Section 1.8)</legend>
    <label><input type="checkbox" name="stripe" <%= settings.paymentProvidersEnabled.stripe ? "checked" : "" %>> Stripe</label>
    <label><input type="checkbox" name="paystack" <%= settings.paymentProvidersEnabled.paystack ? "checked" : "" %>> Paystack</label>
    <label><input type="checkbox" name="flutterwave" <%= settings.paymentProvidersEnabled.flutterwave ? "checked" : "" %>> Flutterwave</label>
  </fieldset>

  <fieldset>
    <legend>Maintenance mode</legend>
    <label><input type="checkbox" name="maintenanceMode" <%= settings.maintenanceMode ? "checked" : "" %>> Enable maintenance mode</label>
    <label>Message<textarea name="maintenanceMessage"><%= settings.maintenanceMessage %></textarea></label>
  </fieldset>

  <button type="submit" class="btn btn--primary">Save settings</button>
</form>
